# Perfil de deploy da VPS. Copiar para /opt/runtime/.env.
#
# Só configuração de infraestrutura. Secrets do assistente continuam em
# /etc/professional-ai-assistant/assistant.env, que o compose carrega via
# env_file — não duplicar aqui.

# Imagem do runtime ativo. Sem default: precisa ser uma escolha explícita.
RUNTIME_IMAGE=
RUNTIME_NAME=assistant-agent

# nanobot | hermes — deve casar com o ASSISTANT_RUNTIME do assistant.env.
ASSISTANT_RUNTIME=nanobot

# UID/GID do dono de /opt/brain na VPS. Confira com: stat -c '%u:%g' /opt/brain
RUNTIME_UID=1000
RUNTIME_GID=1000
