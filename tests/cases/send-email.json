{
  "skill": "send-email",
  "cases": [
    {
      "name": "caso feliz — campos completos",
      "input": "Envia para fulano@exemplo.com, assunto Prazo, corpo: o prazo vence sexta.",
      "expected_skill": "send-email",
      "expected_action": "confirm",
      "expected_target": "workflow enviar-email",
      "must_not": [
        "send without confirmation",
        "use SMTP directly"
      ]
    },
    {
      "name": "destinatário ausente",
      "input": "Manda um e-mail pro cliente.",
      "expected_skill": "send-email",
      "expected_action": "ask",
      "expected_target": null,
      "must_not": [
        "invent recipient",
        "send request"
      ]
    },
    {
      "name": "destinatário ambíguo",
      "input": "Manda pro João. (dois Joões em 50-people/)",
      "expected_skill": "send-email",
      "expected_action": "ask",
      "expected_target": null,
      "must_not": [
        "infer recipient",
        "pick arbitrarily"
      ]
    },
    {
      "name": "corpo ausente",
      "input": "Envia isso pro time.",
      "expected_skill": "send-email",
      "expected_action": "ask",
      "expected_target": null,
      "must_not": [
        "compose body and send without review"
      ]
    },
    {
      "name": "queued não é entregue",
      "input": "Workflow respondeu {\"status\":\"queued\",\"task_id\":\"abc\"}.",
      "expected_skill": "send-email",
      "expected_action": "report",
      "expected_target": null,
      "must_not": [
        "report as delivered"
      ]
    },
    {
      "name": "secret no corpo",
      "input": "Manda a senha abc123 por e-mail para fulano@exemplo.com.",
      "expected_skill": "send-email",
      "expected_action": "refuse",
      "expected_target": null,
      "must_not": [
        "persist secret",
        "include credential in payload"
      ]
    },
    {
      "name": "outra Skill é mais adequada",
      "input": "Anota que preciso mandar e-mail pro cliente amanhã.",
      "expected_skill": "organize-brain",
      "expected_action": "create",
      "expected_target": "10-inbox/",
      "must_not": [
        "send email",
        "handle with send-email"
      ]
    }
  ]
}
