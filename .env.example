# Copie para .env e preencha. NUNCA versione o .env, e NUNCA copie
# estes valores para dentro de brain/ (ver brain/00-system/agent-rules.md).
#
# As Skills referenciam apenas os NOMES conceituais abaixo (ex.: {{N8N_URL}}).
# A resolução dos valores reais é responsabilidade do runtime/ambiente.

# Caminho do brain operacional consumido pelo runtime.
BRAIN_PATH=/caminho/do/brain

# Automação externa (opcional, referenciada como {{N8N_URL}} / {{KESTRA_URL}})
N8N_URL=
N8N_API_KEY=
KESTRA_URL=
KESTRA_API_TOKEN=

# Canal de entrada (opcional; nenhuma integração implementada ainda)
TELEGRAM_BOT_TOKEN=

# Provedor de modelo usado pelo runtime (opcional)
LLM_API_KEY=
LLM_BASE_URL=
