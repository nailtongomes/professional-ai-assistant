# Modelo da configuração operacional do assistente.
#
# O arquivo REAL fica em /etc/professional-ai-assistant/assistant.env, com
# permissão 0600, fora do Git. Este exemplo contém apenas placeholders.
#
# Regra: nenhum valor daqui pode ser copiado para dentro de brain/.
# As Skills referenciam nomes conceituais ({{N8N_URL}}); o runtime resolve.

# --- Identidade e rede ------------------------------------------------------
# Domínio reservado para o assistente. Ainda não exposto publicamente.
ASSISTANT_DOMAIN=tests.n3wizards.com

# --- Automação externa ------------------------------------------------------
# Health check esperado: ${N8N_BASE_URL}/webhook/ping → HTTP 200
N8N_BASE_URL=https://n8n.n3wizards.com
N8N_API_KEY=

# Kestra, quando existir
KESTRA_URL=
KESTRA_API_TOKEN=

# --- Runtime ----------------------------------------------------------------
# Vazio = política padrão: última versão estável publicada pelo instalador
# oficial. Preenchido = pin manual via uv/pip (ver docs/INSTALL.md); o
# instalador oficial não faz pinning por conta própria.
NANOBOT_VERSION=

# Usuário de serviço que executa o runtime. Nunca root.
ASSISTANT_USER=assistant

# Sobrepõe a descoberta automática do binário, se necessário.
# NANOBOT_BIN=
# NANOBOT_BIN_DIR=

# --- Operação ---------------------------------------------------------------
BACKUP_RETENTION_DAYS=14
HEALTHCHECK_TIMEOUT=10

# --- Provedor de modelo -----------------------------------------------------
# Preenchido apenas no arquivo real, nunca aqui.
LLM_API_KEY=
LLM_BASE_URL=

# --- Canais (ainda não implementados) --------------------------------------
TELEGRAM_BOT_TOKEN=
