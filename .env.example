# Modelo da configuração operacional do assistente.
#
# O arquivo REAL fica em /etc/professional-ai-assistant/assistant.env, com
# permissão 0600, fora do Git. Este exemplo só tem nomes de variáveis.
#
# Este repositório é público. Nenhum valor real — domínio, endpoint, webhook,
# token, credencial — pode ser preenchido aqui. Todos ficam vazios: a
# documentação explica o que cada um significa, e a VPS fornece os valores.
#
# Regra: nada daqui pode ser copiado para dentro de brain/. As Skills
# referenciam nomes conceituais ({{PROCESS_QUERY_ENDPOINT}}); o runtime resolve.

# --- Identidade e rede ------------------------------------------------------
# Domínio pretendido para o assistente. Ainda não exposto publicamente.
ASSISTANT_DOMAIN=
ASSISTANT_BASE_URL=

# --- Automação externa ------------------------------------------------------
# Base da instância de automação. Health check: ${N8N_BASE_URL}/webhook/ping
# deve responder HTTP 200.
N8N_BASE_URL=
N8N_API_KEY=

# Kestra, quando existir. O agente não fala com Kestra diretamente — ele fala
# com o n8n, que orquestra o resto.
KESTRA_BASE_URL=
KESTRA_API_TOKEN=

# Consumido pelo RUNTIME nas chamadas de workflow (não pelos scripts de shell).
AUTOMATION_TIMEOUT_SECONDS=30

# --- Endpoints de workflow --------------------------------------------------
# Endpoint COMPLETO de cada workflow, incluindo o path do webhook. O path é
# tratado como sensível: nomes internos de webhook não são versionados.
#
# Preencha a URL inteira. O runtime não concatena base + path: assim o endpoint
# pode viver em outro host sem alterar nada no repositório.
PROCESS_QUERY_ENDPOINT=
PROCESS_COPY_ENDPOINT=
DOCUMENT_QUERY_ENDPOINT=
PERSON_SEARCH_ENDPOINT=
SEND_EMAIL_ENDPOINT=

# --- Runtime ----------------------------------------------------------------
# Qual harness opera o assistente. Valores: nanobot | hermes
# Nanobot é o padrão do MVP. A escolha é sempre explícita — nenhum script
# infere o runtime pela presença de um binário instalado.
ASSISTANT_RUNTIME=nanobot

# Modelo e provider, em termos neutros. Cada adapter traduz para o seu runtime;
# o brain não conhece fornecedor. Chaves de API nunca ficam aqui.
ASSISTANT_MODEL=
ASSISTANT_PROVIDER=

# Sobrepõe o home do Hermes, se necessário (padrão: ~/.hermes do usuário).
# HERMES_HOME=
# Vazio = última versão estável do instalador oficial. Preenchido = pin manual
# via uv/pip (docs/INSTALL.md); o instalador oficial não faz pinning.
NANOBOT_VERSION=

# Usuário de serviço que executa o runtime. Nunca root.
ASSISTANT_USER=assistant

# Sobrepõem a descoberta automática do binário, se necessário.
# NANOBOT_BIN=
# NANOBOT_BIN_DIR=

# --- Layout na máquina ------------------------------------------------------
# Os scripts usam estes caminhos como variáveis. Na VPS, o brain fica em /opt.
# Defina aqui para que doctor, backup, restore e sync ajam no lugar certo.
# BRAIN_DIR=/opt/brain

# --- Operação ---------------------------------------------------------------
BACKUP_RETENTION_DAYS=14

# Consumido por healthcheck.sh e doctor.sh na verificação HTTP.
HEALTHCHECK_TIMEOUT=10

# --- Provedor de modelo -----------------------------------------------------
LLM_API_KEY=
LLM_BASE_URL=

# --- Identidade do owner (controle de acesso) ------------------------------
# O MVP é owner-only: só estas identidades alcançam o agente. Os valores
# alimentam o allowFrom nativo do Nanobot via scripts/configure-nanobot.sh.
#
# FAIL CLOSED: variável vazia NÃO abre o canal — o canal é desabilitado.
# Nunca use ["*"] em canal pessoal.
#
# Telegram: User ID numérico, sem o "@".
OWNER_TELEGRAM_ID=
# WhatsApp: sender ID (telefone sem o "+") ou JID.
OWNER_WHATSAPP_ID=
# Email: endereço completo.
OWNER_EMAIL=

# --- Canais (ainda não implementados) --------------------------------------
TELEGRAM_BOT_TOKEN=

# Sobrepõe o caminho do config.json do Nanobot, se necessário.
# NANOBOT_CONFIG=
